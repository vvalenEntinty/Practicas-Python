def validar_cotas_coordenadas(latitud, longitud):
    try:
        lat = float(latitud)
        lon = float(longitud)
    except:
        return False

    return LAT_MIN <= lat <= LAT_MAX and LON_MIN <= lon <= LON_MAX

def cotas_coordenadas(ruta,encoding,separador):
    with open(ruta, encoding=encoding) as archivo:
        csv_reader = csv.DictReader(archivo , delimiter=separador)
        cotas_invalidas = {}
        for i, row in enumerate(csv_reader,start=2):
            longitud = (row.get("decimalLongitude") or row.get("longitudeDecimal") or "").strip()
            latitud = (row.get("decimalLatitude") or row.get("latitudeDecimal") or "").strip()
            if not validar_cotas_coordenadas(latitud,longitud):
                cotas_invalidas[i] = row
    return cotas_invalidas              
